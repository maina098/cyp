// Prisma schema for CYP platform (PostgreSQL database on Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  passwordHash   String
  name           String
  profileImageUrl String?
  phone          String?
  county         String?
  constituency   String?
  bio            String?
  role           String     @default("USER") // USER, ADMIN
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String? @unique
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash String? @unique
  passwordResetExpiresAt DateTime?
  sessionVersion Int        @default(0)
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  votes            Vote[]
  applications     ElectionApplication[]
  activities       UserActivity[]
  refreshTokens    RefreshToken[]
  votingSessions   VotingSession[]
  voteOtps         VoteOtp[]
  eventParticipations UserEventParticipation[]
  contentReads     UserContentRead[]
  communityServices CommunityService[]
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Governor {
  id        String   @id @default(uuid())
  name      String
  county    String   // e.g. Mombasa, Kwale, Kilifi, Tana River, Lamu, Taita Taveta
  imageUrl  String?
  role      String   @default("Governor") // e.g. Chairman, Vice Chairman, Member
  termStart String?
  termEnd   String?
  status    String   @default("ACTIVE") // ACTIVE, RETIRED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecretariatMember {
  id        String   @id @default(uuid())
  name      String
  role      String   // e.g. CEO, Program Manager, Technical Lead
  imageUrl  String?
  bio       String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  summary     String
  content     String    // Rich text or markdown content
  category    String    // e.g. Press Release, Event, Project, General
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  date        DateTime
  status      String   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, CANCELLED
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  participations UserEventParticipation[]
}

model Resource {
  id             String   @id @default(uuid())
  title          String
  description    String?
  fileUrl        String   // Link to file (pdf, docs, etc.)
  category       String   // e.g. Blueprints, Reports, Newsletters, Procurement
  downloadsCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserEventParticipation {
  id          String   @id @default(uuid())
  userId      String
  eventId     String
  title       String
  description String?
  mediaUrl    String?
  mediaType   String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventId])
}

model UserContentRead {
  id        String   @id @default(uuid())
  userId    String
  contentType String
  contentId String
  readAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([userId, readAt])
}

model CommunityService {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  mediaUrl    String?
  mediaType   String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PartnerRequest {
  id           String   @id @default(uuid())
  name         String
  email        String
  organization String
  proposal     String
  status       String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, DECLINED
  createdAt    DateTime @default(now())
}

// Elections module
model Election {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("draft") // draft | scheduled | active | closed
  startsAt    DateTime
  endsAt      DateTime
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidates      Candidate[]
  votes           Vote[]
  electionResults ElectionResult[]
  positions       ElectionPosition[]
  applications    ElectionApplication[]
  positionResults PositionResult[]
}

model Candidate {
  id         String   @id @default(uuid())
  electionId String
  positionId String
  name       String
  bio        String?
  photoUrl   String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  positionRecord ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  votes    Vote[]
  results  ElectionResult[]

  @@index([electionId])
}

model Vote {
  id          String   @id @default(uuid())
  electionId  String
  candidateId String
  positionId  String
  voterId     String
  votedAt     DateTime @default(now())

  election  Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position  ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  voter     User      @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([electionId, positionId, voterId])
  @@index([electionId])
  @@index([voterId])
}

model VoteOtp {
  id          String    @id @default(uuid())
  electionId  String
  userId      String
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([electionId, userId])
  @@index([expiresAt])
}

model VotingSession {
  id          String    @id @default(uuid())
  electionId  String
  userId      String
  otpId       String    @unique
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([electionId, userId])
}

model ElectionResult {
  id          String   @id @default(uuid())
  electionId  String
  candidateId String
  voteCount   Int      @default(0)
  updatedAt   DateTime @updatedAt

  election  Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([electionId, candidateId])
  @@index([electionId])
}

model PositionResult {
  id          String   @id @default(uuid())
  electionId  String
  positionId  String
  candidateId String?
  totalVotes  Int      @default(0)
  percentage  Decimal? @db.Decimal(5, 2)
  winnerName  String?
  isTie       Boolean  @default(false)
  computedAt  DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([electionId, positionId])
  @@index([electionId])
}

// Election Positions and Applications
model ElectionPosition {
  id          String   @id @default(uuid())
  electionId  String
  title       String   // e.g. "COUNTY YOUTH GOVERNOR", "SECRETARY GENERAL"
  description String?
  isOpen      Boolean  @default(false) // Admin can open/close applications
  maxApplicants Int    @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election     Election              @relation(fields: [electionId], references: [id], onDelete: Cascade)
  applications ElectionApplication[]
  positionCandidates Candidate[]
  votes             Vote[]
  positionResults   PositionResult[]

  @@unique([electionId, title])
  @@index([electionId])
}

model ElectionApplication {
  id               String   @id @default(uuid())
  positionId       String
  userId           String
  electionId       String
  name             String
  email            String
  county           String
  constituency     String?
  age              Int?
  description      String
  reasonForApplying String?
  changeChampion   String?
  comments         String?
  status           String   @default("pending") // pending | approved | rejected | withdrawn
  appliedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  position   ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  election   Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([positionId, userId])
  @@index([positionId])
  @@index([userId])
  @@index([electionId])
  @@index([status])          // Added for filtering by status
  @@index([electionId, status]) // Composite index for common query
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  email     String
  name      String
  action    String   // login, logout, view, apply, etc.
  details   String?  // Additional details about the action
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
